{% extends 'base.html.twig' %}
{% block title %}Connexion — SailingLoc{% endblock %}
{% block body %}
<div style="max-width:420px; margin: 48px auto; background:#fff; padding:40px; border-radius:12px; box-shadow:0 4px 24px rgba(0,0,0,.08);">
    <h1 style="text-align:center; margin:0 0 32px; font-size:24px;">Connexion ⚓</h1>

    {% if error %}
        <div class="flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post">
        <div style="margin-bottom:16px;">
            <label style="display:block; font-weight:600; margin-bottom:6px;">Email</label>
            <input type="email" name="_username" value="{{ last_username }}" required autofocus
                   style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:15px;">
        </div>
        <div style="margin-bottom:24px;">
            <label style="display:block; font-weight:600; margin-bottom:6px;">Mot de passe</label>
            <input type="password" name="_password" required
                   style="width:100%; padding:12px; border:1px solid #d1d5db; border-radius:8px; font-size:15px;">
        </div>
        <div style="margin-bottom:24px;">
            <label style="font-size:14px; color:#718096;">
                <input type="checkbox" name="_remember_me"> Se souvenir de moi
            </label>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit"
                style="width:100%; background:#1866F2; color:#fff; border:none; padding:14px; border-radius:8px; font-size:16px; font-weight:600; cursor:pointer;">
            Se connecter
        </button>
    </form>
</div>
{% endblock %}
